MC_HOST=your-minecraft-server-address
MC_PORT=25565
MC_USERNAME=Lumi
MC_AUTH=offline
MC_VERSION=1.21.11

# Minecraft server authentication plugin credentials (keep this secret).
MC_SERVER_PASSWORD=replace-with-your-server-auth-password
# Repeat the /register, /register, /login sequence every 45 seconds.
# Must be less than 60000 milliseconds.
MC_AUTH_RETRY_INTERVAL=45000

# Your only public allocation
WEB_HOST=0.0.0.0
WEB_PORT=16855
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password

APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Internal viewer listener only; do not allocate or expose this port publicly.
VIEWER_INTERNAL_PORT=3001
VIEWER_DISTANCE=8

BOT_NAME=Lumi
MC_CHAT_TIMEOUT=180000
WEB_CHAT_TIMEOUT=300000
AI_CONTEXT_MESSAGES=10
AI_ENABLED=true
DB_PATH=./data/lumi.sqlite
